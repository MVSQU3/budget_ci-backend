# Copie ce fichier en .env et adapte les valeurs
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=budget_fcfa

JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=7d

# console = code OTP affiché dans les logs (dev). Plus tard : orange, termii...
SMS_PROVIDER=console
PORT=3000

# Clé privée Ed25519 qui signe les jetons de licence.
# Génère-la avec : node scripts/generer-cles-licence.js
# La clé publique correspondante se colle dans app/src/utils/licence.js
# ⚠ Sans cette variable, le serveur démarre avec une clé éphémère (dev uniquement).
LICENCE_CLE_PRIVEE=Rk945oHJ7a8Fh0GmK8FLxpIoEuRPR1uNOn8f1jCqp9dNRi3xjdwrKWUWavLa5hfN8NmtNv37/d2p4naOoQPvmQ==

# Durée de l'essai gratuit, en jours
ESSAI_JOURS=14
# Durée d'une période payée, en jours
ABONNEMENT_JOURS=30
